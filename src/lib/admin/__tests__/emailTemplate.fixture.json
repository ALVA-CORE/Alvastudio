{"html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<meta name=\"supported-color-schemes\" content=\"light dark\">\n<title>Recording guidance &amp; you</title>\n<style>\n  :root { color-scheme: light dark; supported-color-schemes: light dark; }\n  /* Our colours again, !important, so a client applying its own dark\n     styles applies ours. */\n  @media (prefers-color-scheme: dark) {\n    .bg { background:#090909 !important; }\n    .card { background:#202020 !important; }\n    .text { color:#F5F5F4 !important; }\n    .muted { color:#A1A1AA !important; }\n  }\n  /* The Outlook app's dark mode. */\n  [data-ogsc] .text { color:#F5F5F4 !important; }\n  [data-ogsc] .muted { color:#A1A1AA !important; }\n  [data-ogsb] .bg { background:#090909 !important; }\n  [data-ogsb] .card { background:#202020 !important; }\n  /* Gmail alone puts a <u> before the body: these undo its inversion of\n     light text (see light()). */\n  u + .body .gmail-screen { background:#000; mix-blend-mode:screen; }\n  u + .body .gmail-difference { background:#000; mix-blend-mode:difference; }\n  @media only screen and (max-width:480px) {\n    .outer { padding:16px 10px !important; }\n    .hero-wrap { padding:14px 16px 0 !important; }\n    .hero { max-height:150px !important; }\n    .copy-wrap { padding:18px 16px 0 !important; }\n    .title { font-size:22px !important; margin-bottom:10px !important; }\n    .copy { font-size:14px !important; margin-bottom:10px !important; }\n    .button-wrap { padding:22px 16px 4px !important; }\n    .rule { padding:16px 16px 0 !important; }\n    .legal { padding:14px 16px 0 !important; font-size:11px !important; }\n    .footer-wrap { padding:12px 12px 14px !important; }\n    .footer { border-radius:14px !important; }\n    .mark { width:26px !important; height:26px !important; }\n    .word { font-size:14px !important; padding-left:8px !important; }\n    .social { width:32px !important; height:32px !important; }\n    .social-gap { margin-left:6px !important; }\n  }\n</style>\n</head>\n<body class=\"body bg\" style=\"margin:0;background:#090909;background-image:linear-gradient(#090909,#090909);color:#F5F5F4;font-family:'Schibsted Grotesk',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\">\n<div style=\"display:none;max-height:0;overflow:hidden;\">Please review &lt;the&gt; &quot;updated&quot; guidance &amp; tips.\nSecond line here.</div>\n<table class=\"bg\" role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#090909\" style=\"background:#090909;background-image:linear-gradient(#090909,#090909);\">\n<tr><td class=\"outer\" align=\"center\" style=\"padding:32px 16px;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;\">\n<tr><td class=\"card\" bgcolor=\"#202020\" style=\"background:#202020;background-image:linear-gradient(#202020,#202020);border-radius:28px;\">\n\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tr><td class=\"hero-wrap\" style=\"padding:22px 24px 0;\">\n<img class=\"hero\" src=\"https://www.alvacoreai.com/assets/og.png\" alt=\"\" width=\"512\" style=\"display:block;width:100%;max-height:220px;object-fit:cover;border:0;border-radius:16px;\">\n</td></tr>\n<tr><td class=\"copy-wrap\" align=\"left\" style=\"padding:28px 24px 0;\">\n<h1 class=\"title text\" style=\"margin:0 0 16px;font-size:28px;line-height:1.2;font-weight:600;letter-spacing:-0.5px;color:#F5F5F4;text-align:left;\"><span class=\"gmail-screen\"><span class=\"gmail-difference\">Recording guidance &amp; you</span></span></h1>\n<p class=\"copy text\" style=\"margin:0 0 12px;font-size:15px;line-height:1.6;color:#F5F5F4;text-align:left;\"><span class=\"gmail-screen\"><span class=\"gmail-difference\">Hi Ada,</span></span></p>\n<p class=\"copy muted\" style=\"margin:0 0 12px;font-size:15px;line-height:1.6;color:#A1A1AA;\"><span class=\"gmail-screen\"><span class=\"gmail-difference\">Please review &lt;the&gt; &quot;updated&quot; guidance &amp; tips.<br>Second line here.</span></span></p><p class=\"copy muted\" style=\"margin:0 0 12px;font-size:15px;line-height:1.6;color:#A1A1AA;\"><span class=\"gmail-screen\"><span class=\"gmail-difference\">Thank you, it&#x27;s appreciated.</span></span></p>\n<p class=\"copy muted\" style=\"margin:0;font-size:15px;line-height:1.6;color:#A1A1AA;text-align:left;\"><span class=\"gmail-screen\"><span class=\"gmail-difference\">Need help? Contact <a href=\"mailto:support@alvacoreai.com\" style=\"color:#25F07D;text-decoration:underline;\">support@alvacoreai.com</a></span></span></p>\n</td></tr>\n<tr><td class=\"button-wrap\" align=\"center\" style=\"padding:32px 24px 8px;\">\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" align=\"center\"><tr>\n<td bgcolor=\"#25F07D\" align=\"center\" style=\"background-color:#25F07D;background-image:url(https://api.alvacoreai.com/static/email/accent.png);background-repeat:repeat;border-radius:999px;\">\n<a href=\"https://studio.alvacoreai.com/contributor/dashboard?a=1&amp;b=2\" style=\"display:inline-block;padding:14px 28px;border-radius:999px;background-color:#25F07D;background-image:url(https://api.alvacoreai.com/static/email/accent.png);background-repeat:repeat;color:#090909;font-size:14px;font-weight:600;line-height:1;text-decoration:none;\">Read the guidance</a>\n</td>\n</tr></table>\n</td></tr>\n<tr><td class=\"rule\" style=\"padding:20px 24px 0;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr>\n<td bgcolor=\"#2A2A2A\" height=\"1\" style=\"height:1px;font-size:0;line-height:0;background:#2A2A2A;background-image:linear-gradient(#2A2A2A,#2A2A2A);\">&nbsp;</td>\n</tr></table>\n</td></tr>\n<tr><td class=\"legal muted\" style=\"padding:16px 24px 0;font-size:12px;line-height:1.4;color:#A1A1AA;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr>\n<td class=\"muted\" align=\"left\" valign=\"middle\" style=\"color:#A1A1AA;\"><span class=\"gmail-screen\"><span class=\"gmail-difference\">\u00a9 2026 Alvacore</span></span></td>\n<td class=\"muted\" align=\"right\" valign=\"middle\" style=\"color:#A1A1AA;white-space:nowrap;\"><span class=\"gmail-screen\"><span class=\"gmail-difference\"><a href=\"https://alvacoreai.com/terms\" style=\"color:#A1A1AA;text-decoration:none;\">Terms of use</a>&nbsp;\u00b7&nbsp;<a href=\"https://alvacoreai.com/privacy\" style=\"color:#A1A1AA;text-decoration:none;\">Privacy</a></span></span></td>\n</tr></table>\n</td></tr>\n<tr><td class=\"footer-wrap\" style=\"padding:14px 16px 16px;\">\n<table class=\"footer bg\" role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#090909\" style=\"background:#090909;background-image:linear-gradient(#090909,#090909);border-radius:16px;\">\n<tr>\n<td valign=\"middle\" align=\"left\" style=\"padding:14px 8px 14px 18px;\">\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr>\n<td valign=\"middle\"><img class=\"mark\" src=\"https://api.alvacoreai.com/static/email/logo.png\" alt=\"\" width=\"32\" height=\"32\" style=\"display:block;width:32px;height:32px;border:0;\"></td>\n<td class=\"word text\" valign=\"middle\" style=\"padding-left:10px;font-size:16px;font-weight:600;line-height:1;color:#F5F5F4;\"><span class=\"gmail-screen\"><span class=\"gmail-difference\">Alvacore</span></span></td>\n</tr></table>\n</td>\n<td align=\"right\" valign=\"middle\" style=\"padding:14px 18px 14px 8px;white-space:nowrap;\">\n<a href=\"https://x.com\" aria-label=\"X\" class=\"social-gap\" style=\"display:inline-block;vertical-align:middle;text-decoration:none;margin-left:8px;\"><table role=\"presentation\" class=\"social card\" cellspacing=\"0\" cellpadding=\"0\" width=\"36\" height=\"36\" bgcolor=\"#202020\" style=\"width:36px;height:36px;border-radius:999px;background:#202020;background-image:linear-gradient(#202020,#202020);\"><tr><td align=\"center\" valign=\"middle\" width=\"36\" height=\"36\" style=\"width:36px;height:36px;line-height:0;font-size:0;\"><img src=\"https://api.alvacoreai.com/static/email/x.png\" alt=\"\" width=\"16\" height=\"16\" style=\"display:block;width:16px;height:16px;border:0;\"></td></tr></table></a><a href=\"https://www.linkedin.com\" aria-label=\"LinkedIn\" class=\"social-gap\" style=\"display:inline-block;vertical-align:middle;text-decoration:none;margin-left:8px;\"><table role=\"presentation\" class=\"social card\" cellspacing=\"0\" cellpadding=\"0\" width=\"36\" height=\"36\" bgcolor=\"#202020\" style=\"width:36px;height:36px;border-radius:999px;background:#202020;background-image:linear-gradient(#202020,#202020);\"><tr><td align=\"center\" valign=\"middle\" width=\"36\" height=\"36\" style=\"width:36px;height:36px;line-height:0;font-size:0;\"><img src=\"https://api.alvacoreai.com/static/email/linkedin.png\" alt=\"\" width=\"16\" height=\"16\" style=\"display:block;width:16px;height:16px;border:0;\"></td></tr></table></a>\n</td>\n</tr>\n</table>\n</td></tr>\n</table>\n\n</td></tr>\n</table>\n</td></tr>\n</table>\n</body>\n</html>", "body": "Please review <the> \"updated\" guidance & tips.\nSecond line here.\n\nThank you, it's appreciated."}