# Where the Alva Studio backend lives. See docs/backend/api.md.
#
# Leave BOTH unset and the dev server proxies /api/v1 to http://localhost:8000,
# which is what you want when running the backend locally.

# Keep same-origin calls and change where the dev proxy forwards them.
# This is the right setting for the deployed backend, and the only one that
# works when testing on a phone over the LAN: the device loads
# http://<your-lan-ip>:3000, which the backend's CORS allowlist does not
# contain. Through the proxy there is no cross-origin request to block.
# VITE_API_PROXY_TARGET=https://api.alvacoreai.com

# Point the browser at a backend directly (include the /api/v1 prefix).
# This is what a production build uses, where the deployed origin IS on the
# allowlist. In dev it brings CORS back — prefer the proxy above.
# VITE_API_BASE_URL=https://api.example.com/api/v1
