# Where the Alva Studio backend lives. See docs/api.md.
#
# Leave BOTH unset and the dev server proxies /api/v1 to http://localhost:8000,
# which is what you want when running the backend locally.

# Point the app at a backend on another host (include the /api/v1 prefix).
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Or keep same-origin calls and just change where the dev proxy forwards them.
# VITE_API_PROXY_TARGET=http://localhost:8000
